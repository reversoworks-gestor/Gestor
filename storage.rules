rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function workspaceMember() {
      return signedIn()
        && exists(/databases/(default)/documents/workspaces/reverso-private)
        && request.auth.token.email != null
        && request.auth.token.email.lower() in get(/databases/(default)/documents/workspaces/reverso-private).data.allowedEmails;
    }
    match /workspaces/reverso-private/stl/{fileName} {
      allow read: if workspaceMember();
      allow write: if workspaceMember()
        && request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType == 'model/stl';
      allow delete: if workspaceMember();
    }

    match /workspaces/reverso-private/documents/{orderId}/{fileName} {
      allow read, delete: if workspaceMember();
      allow create, update: if workspaceMember()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf', 'image/png', 'image/jpeg', 'model/stl'
        ];
    }
  }
}
