rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function workspaceMember() {
      return signedIn()
        && exists(/databases/(default)/documents/workspaces/reverso-private)
        && request.auth.token.email != null
        && request.auth.token.email.lower() in get(/databases/(default)/documents/workspaces/reverso-private).data.allowedEmails;
    }
    match /workspaces/reverso-private/stl/{fileName} {
      allow read, write: if workspaceMember()
        && request.resource == null || (workspaceMember() && request.resource.size < 50 * 1024 * 1024 && request.resource.contentType == 'model/stl');
    }
  }
}
